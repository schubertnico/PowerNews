# =====================================================================
#  PowerNews – .gitattributes
# ---------------------------------------------------------------------
#  1. Zeilenenden: Textdateien liegen mit LF im Repository und im
#     Release-Archiv (Linux-Hoster).
#  2. export-ignore: Diese Dateien bleiben im Repository, landen aber
#     nicht im Release-Archiv bzw. Deploy-Paket:
#       git archive --format=zip --prefix=powernews/ -o powernews.zip HEAD
#     Prüfen:  git archive --format=tar HEAD | tar -t
# =====================================================================

# ---------- Zeilenenden ----------
* text=auto
*.php     text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.json5   text eol=lf
*.xml     text eol=lf
*.neon    text eol=lf
*.yml     text eol=lf
*.ini     text eol=lf
*.txt     text eol=lf
.htaccess text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ---------- Binärdateien ----------
*.gif  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.zip  binary

# =====================================================================
#  export-ignore: nicht im Release-Archiv
# =====================================================================

# Git
/.gitattributes      export-ignore
/.gitignore          export-ignore

# CI und Docker-Entwicklungsstack (inkl. .docker/dev-seed.sql mit Test-Admin)
/.github/            export-ignore
/.docker/            export-ignore

# Interne Dokumentation, Audit-Berichte, Notizen
/docs/               export-ignore
/todos/              export-ignore

# Tests
/tests/              export-ignore
/phpunit.xml         export-ignore
/phpunit.xml.dist    export-ignore

# Statische Analyse und Code-Qualität
/phpstan.neon        export-ignore
/phpstan-baseline.neon export-ignore
/psalm.xml           export-ignore
/phpmd*              export-ignore
/rector.php          export-ignore
/infection.json5     export-ignore
/.php-cs-fixer.php   export-ignore
/.php-cs-fixer.dist.php export-ignore

# Composer: PowerNews hat keine Laufzeit-Abhängigkeiten, composer.json
# beschreibt nur die Entwicklungswerkzeuge.
/composer.json       export-ignore
/composer.lock       export-ignore

# Hinweis: powernews.sql bleibt im Paket – der Web-Installer liest es ein.
# pninc/installer/ ebenso (Installer und update.php); install.php löscht
# der Betreiber nach der Installation.
